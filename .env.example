# URL aplikasi (dipakai di link verifikasi email dan email transaksional)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (penyusun Peta Potensimu)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Bantuan WhatsApp (format internasional tanpa +)
NEXT_PUBLIC_WA_NUMBER=6281200000000

# Tujuan bayar
NEXT_PUBLIC_QRIS_IMAGE=/qris.png
NEXT_PUBLIC_QRIS_NMID=
NEXT_PUBLIC_QRIS_MERCHANT=NAWASENA
NEXT_PUBLIC_BANK_NAME=BCA
NEXT_PUBLIC_BANK_ACCOUNT=
NEXT_PUBLIC_BANK_HOLDER=PT Nawasena
NEXT_PUBLIC_REVIEW_TARGET=maksimal 1 x 24 jam di hari kerja

# Email transaksional (opsional; tanpa ini email hanya dicatat di log)
RESEND_API_KEY=
EMAIL_FROM=Nawasena <halo@nawasena.id>

# Backoffice: set "false" hanya untuk development lokal
ADMIN_REQUIRE_MFA=true

# Cron retensi 12 bulan (Vercel Cron mengirim Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
